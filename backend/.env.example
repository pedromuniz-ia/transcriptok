# TranscripTok Backend Configuration

# App
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-random-string

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/transcriptok

# Redis
REDIS_URL=redis://localhost:6379/0

# Whisper Configuration
WHISPER_MODE=local
WHISPER_MODEL=base

# LLM Providers (at least one required for AI tools)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GROQ_API_KEY=gsk_your-groq-key

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage

# CORS (comma-separated for multiple origins)
CORS_ORIGINS=["http://localhost:3000"]
